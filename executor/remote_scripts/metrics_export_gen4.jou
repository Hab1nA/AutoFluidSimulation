; Fluent 2024 R1 metrics export journal template.
; Replace {{CASE_DATA_PATH}} and {{EXPORT_DIR}} before execution.
; The companion compute_metrics_gen4.py script owns final metric formulas.

/file/set-tui-version "24.1"
/file/read-case-data "{{CASE_DATA_PATH}}"

; Required zones confirmed on model_gen4_1.cas.h5:
; inlets: inlet_oxidizer, inlet_fuel
; outlet: outlet
; fluid: s------6.5076
; side walls used by Twall/Tmax: wall_chamber, wall_nozzle, wall_throat
; diagnostic-only walls not included in metrics: wall_top, wall_gap, s------6
; scalar fields: temperature, fmean, heat-release-rate, cell-volume, heat-flux, x-coordinate
; face fields: pressure, density, x-velocity, x-face-area, face-area-magnitude

; Core scalar reports captured into metrics_reports.csv by the PyFluent wrapper:
/report/surface-integrals/mass-flow-rate inlet_oxidizer ()
/report/surface-integrals/mass-flow-rate inlet_fuel ()
/report/surface-integrals/mass-flow-rate outlet ()
/report/surface-integrals/area outlet ()
/report/surface-integrals/area wall_chamber wall_nozzle wall_throat ()
/report/surface-integrals/area-weighted-avg wall_chamber wall_nozzle wall_throat () temperature
/report/surface-integrals/facet-max wall_throat () temperature
/report/surface-integrals/facet-max wall_chamber wall_nozzle wall_throat () temperature
/report/volume-integrals/volume s------6.5076 ()
/report/volume-integrals/volume-integral s------6.5076 () heat-release-rate

; Final automated path avoids exporting multi-million-row cell/face tables.
; PyFluent additionally defines custom field functions and integrates them in Fluent:
;   cff_thrust_momentum_x =
;     density*x_velocity*(x_velocity*x_face_area + y_velocity*y_face_area + z_velocity*z_face_area)
;     /(face_area_magnitude+1e-30)
;   cff_thrust_pressure_x =
;     (pressure - pa)*x_face_area/(face_area_magnitude+1e-30)
; and then runs:
;   surface_integrals.integral(outlet, report_of=cff_thrust_momentum_x)
;   surface_integrals.integral(outlet, report_of=cff_thrust_pressure_x)
;
; PyFluent also computes chamber-only mixture-ratio integrals with Fluent Expressions:
;   phi_hot_volume = Sum(IF(StaticTemperature > Tcomb,
;                          IF(Position.x <= chamber_x_max, 1, 0), 0),
;                        ['s------6.5076'], Weight="Volume")
;   phi_sum        = Sum(IF(..., ((1-MeanMixtureFraction)/(MeanMixtureFraction+1e-12))/4, 0),
;                        ['s------6.5076'], Weight="Volume")
;   phi2_sum       = Sum(IF(..., phi*phi, 0), ['s------6.5076'], Weight="Volume")
; where chamber_x_max defaults to the minimum x-coordinate on wall_throat.

; Optional diagnostic-only CSV fallback field sets, not required for final metrics:
; outlet: density, x-velocity, y-velocity, z-velocity, pressure,
;         x-face-area, y-face-area, z-face-area
; fluid s------6.5076: temperature, fmean, cell-volume, x-coordinate, heat-release-rate
; side walls only: wall_chamber, wall_nozzle, wall_throat
; wall fields: temperature, face-area-magnitude, heat-flux
