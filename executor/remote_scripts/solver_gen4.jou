/file/set-tui-version "24.1"
/file/read-settings "{{REMOTE_ROOT}}/solver_gen4.set" 
(cx-gui-do cx-set-list-tree-selections "NavigationPane*Frame2*Table1*List_Tree2" (list "Solution|Initialization"))
