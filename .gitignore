# ============================================================================
# Git 忽略规则
# ============================================================================

# 环境变量文件（包含敏感信息，如 SSH 密钥）
.env

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
env/
.venv/

# IDE
.vscode/
.idea/

# 操作系统
.DS_Store
Thumbs.db

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 日志目录及文件
logs/
*.log

# 测试输出文件
test_result*.txt

# ============================================================================
# Rust 编译产物
# ============================================================================

# Cargo 编译输出目录（最重要，包含所有编译产物）
target/

# Cargo 依赖锁定文件（可选，某些团队选择跟踪）
Cargo.lock

# Rust 源文件备份
*.rs.bk

# Rust 库文件
*.rlib
*.a

# 共享库和动态链接库
*.so
*.so.*
*.dll
*.dll.*

# Windows 可执行文件
*.exe

# macOS 应用程序包
*.app
