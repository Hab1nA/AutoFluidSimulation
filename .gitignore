# ============================================================================
# Git 忽略规则
# ============================================================================

# 环境变量文件（包含敏感信息，如 SSH 密钥）
.env

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
env/
.venv/

# IDE
.vscode/
.idea/

# 操作系统
.DS_Store
Thumbs.db

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 日志目录及文件
logs/
*.log

# 测试输出文件
test_result*.txt

# Rust / Cargo 编译产物
**/target/
**/*.rs.bk
Cargo.lock
