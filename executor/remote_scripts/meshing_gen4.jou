/file/set-tui-version "24.1"
(%py-exec "workflow.LoadWorkflow(FilePath=r'{{REMOTE_ROOT}}/meshing_gen4.wft')")
(%py-exec "workflow.TaskObject['Improve Volume Mesh'].ExecuteUpstreamNonExecutedAndThisTask()")

(cx-gui-do cx-activate-item "MenuBar*ToolsSubMenu*Auto Node Move...")

(cx-gui-do cx-activate-item "Auto Node Move*Table1*PushButton6(Quality Measure)")
(cx-gui-do cx-set-toggle-button2 "Quality Measure*ToggleBox1(Measure)*Aspect Ratio" #t)
(cx-gui-do cx-activate-item "Quality Measure*ToggleBox1(Measure)*Aspect Ratio")
(cx-gui-do cx-activate-item "Quality Measure*PanelButtons*PushButton3(Apply)")
(cx-gui-do cx-activate-item "Quality Measure*PanelButtons*PushButton1(Close)")
(cx-gui-do cx-set-real-entry-list "Auto Node Move*Table1*Frame1*Frame1(Parameters)*RealEntry1(Quality Limit)" '( 80))
(cx-gui-do cx-set-integer-entry "Auto Node Move*Table1*Frame4*Frame1(Auto Correction)*IntegerEntry1(Iterations)" 20)
(cx-gui-do cx-activate-item "Auto Node Move*Table1*Frame4*Frame1(Auto Correction)*IntegerEntry1(Iterations)")
(cx-gui-do cx-activate-item "Auto Node Move*Table1*Frame4*Frame1(Auto Correction)*PushButton2(Apply)")

(cx-gui-do cx-activate-item "Auto Node Move*Table1*PushButton6(Quality Measure)")
(cx-gui-do cx-set-toggle-button2 "Quality Measure*ToggleBox1(Measure)*Orthogonal Quality" #t)
(cx-gui-do cx-activate-item "Quality Measure*ToggleBox1(Measure)*Orthogonal Quality")
(cx-gui-do cx-activate-item "Quality Measure*PanelButtons*PushButton3(Apply)")
(cx-gui-do cx-activate-item "Quality Measure*PanelButtons*PushButton1(Close)")
(cx-gui-do cx-set-real-entry-list "Auto Node Move*Table1*Frame1*Frame1(Parameters)*RealEntry1(Quality Limit)" '( 0.25))
(cx-gui-do cx-set-integer-entry "Auto Node Move*Table1*Frame4*Frame1(Auto Correction)*IntegerEntry1(Iterations)" 20)
(cx-gui-do cx-activate-item "Auto Node Move*Table1*Frame4*Frame1(Auto Correction)*IntegerEntry1(Iterations)")
(cx-gui-do cx-activate-item "Auto Node Move*Table1*Frame4*Frame1(Auto Correction)*PushButton2(Apply)")

(cx-gui-do cx-activate-item "Auto Node Move*Table1*PushButton6(Quality Measure)")
(cx-gui-do cx-set-toggle-button2 "Quality Measure*ToggleBox1(Measure)*Skewness" #t)
(cx-gui-do cx-activate-item "Quality Measure*ToggleBox1(Measure)*Skewness")
(cx-gui-do cx-activate-item "Quality Measure*PanelButtons*PushButton3(Apply)")
(cx-gui-do cx-activate-item "Quality Measure*PanelButtons*PushButton1(Close)")
(cx-gui-do cx-set-real-entry-list "Auto Node Move*Table1*Frame1*Frame1(Parameters)*RealEntry1(Quality Limit)" '( 0.7))
(cx-gui-do cx-set-integer-entry "Auto Node Move*Table1*Frame4*Frame1(Auto Correction)*IntegerEntry1(Iterations)" 20)
(cx-gui-do cx-activate-item "Auto Node Move*Table1*Frame4*Frame1(Auto Correction)*IntegerEntry1(Iterations)")
(cx-gui-do cx-activate-item "Auto Node Move*Table1*Frame4*Frame1(Auto Correction)*PushButton2(Apply)")

(cx-gui-do cx-activate-item "Auto Node Move*PanelButtons*PushButton1(Close)")
(cx-gui-do cx-activate-item "MenuBar*WriteSubMenu*Stop Journal")







